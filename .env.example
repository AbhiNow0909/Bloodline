# Copy to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev default. Inside Docker Compose the host is the `db` service instead
# of localhost. In production this is the Neon connection string.
DATABASE_URL=postgresql+psycopg://bloodline:bloodline@localhost:5432/bloodline

# --- LLM (Groq) -------------------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
STRUCTURING_MODEL=openai/gpt-oss-20b
AGENT_MODEL=openai/gpt-oss-120b

# --- Embeddings (run locally) -----------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- API --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
