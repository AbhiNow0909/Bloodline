# Copy to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev default. Inside Docker Compose the host is the `db` service instead
# of localhost. In production this is the Neon connection string.
DATABASE_URL=postgresql+psycopg://bloodline:bloodline@localhost:5432/bloodline

# --- LLM (Groq) -------------------------------------------------------------
# Create a key at https://console.groq.com/keys. Needed only to structure reports
# (and for the optional live test); the API and the other tests run without it.
# Only scrubbed report text (no names, IDs, addresses or doctors) is ever sent to Groq.
GROQ_API_KEY=
STRUCTURING_MODEL=openai/gpt-oss-20b
AGENT_MODEL=openai/gpt-oss-120b

# --- Embeddings (run locally) -----------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TREND_ALERT_PERCENT=25
TREND_ALERT_RESULTS=3

# --- Auth -------------------------------------------------------------------
# Required, at least 32 characters. Generate with: openssl rand -hex 32
# Changing it logs everyone out (existing tokens stop validating).
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- API --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Largest accepted report PDF (1-50).
MAX_UPLOAD_MB=10

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
